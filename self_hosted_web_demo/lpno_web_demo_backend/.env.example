# Copy to .env for local runs. Models + ground truth default to the in-repo
# data/<page>/ layout (see data/README.md; populate with
# `python scripts/assets.py fetch zenodo`), so no asset paths are needed here.

# App server (used by `python -m app.main`; a uvicorn command line sets its own
# --host/--port). 127.0.0.1 keeps the server on this machine; 0.0.0.0 exposes
# it, without authentication, to every network the machine is on.
LPFNO_HOST=127.0.0.1
LPFNO_PORT=8000
LPFNO_UVICORN_WORKERS=1
LPFNO_LOG_LEVEL=INFO
LPFNO_STARTUP_LOAD_RUNTIME=true

# Exact page origin for CORS (no trailing slash), needed when the frontend is
# served from another origin than the backend. Leave it unset behind a
# same-origin proxy (the frontend Docker image); dev/run_local.sh sets it itself.
LPFNO_PAGES_ORIGIN=http://127.0.0.1:8080

# Input bounds (server-side clamp of the steady route; the served catalog's range)
LPFNO_P_MIN_WATTS=40
LPFNO_P_MAX_WATTS=215
LPFNO_V_MIN_MPS=0.101
LPFNO_V_MAX_MPS=0.96

# Notebook-derived steady runtime parameters
LPFNO_RUNTIME_SUPER_RES_FACTOR=2
LPFNO_RUNTIME_TIME_AVG_WINDOW=30
LPFNO_RUNTIME_INITIAL_P_WATTS=50
LPFNO_RUNTIME_INITIAL_V_MPS=0.26

LPFNO_USE_STUB_RUNTIME=false

# --- Asset path overrides (optional) -------------------------------------
# Defaults point at the in-repo data/ layout (see data/README.md); uncomment
# only to serve models or ground truth from elsewhere. Use these exact names:
# an unknown LPFNO_* key in THIS FILE aborts startup ("Extra inputs are not
# permitted"), while a misspelled one exported in the shell is silently ignored.
# LPFNO_STEADY_MODELS_DIR=data/steady-state/models
# LPFNO_RUNTIME_RUN_DIR=data/steady-state/models/fno_cal
# LPFNO_RUNTIME_CHECKPOINT_PATH=data/steady-state/models/fno_cal/u_network.0.pth
# LPFNO_RUNTIME_SIM_PARAMS_PATH=data/steady-state/models/fno_cal/flow3D_params.yaml
# LPFNO_STEADY_GT_DATA_DIR=data/steady-state/ground_truth_calibrated
# LPFNO_STRAIGHT_MODELS_DIR=data/straight_path_time/models
# LPFNO_STRAIGHT_DATA_DIR=data/straight_path_time/ground_truth_calibrated
# LPFNO_PATH_MODELS_DIR=data/random_path/models
# LPFNO_PATH_DATA_DIR=data/random_path/ground_truth
