server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 16k;

    proxy_connect_timeout 3s;
    proxy_send_timeout 15s;
    proxy_read_timeout 50s;
    send_timeout 15s;

    location = /frontend-healthz {
        default_type text/plain;
        return 200 'ok';
    }

    location = /healthz {
        proxy_http_version 1.1;
        proxy_set_header Host ${LPFNO_BACKEND_HOST_HEADER};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        ${LPFNO_BACKEND_TLS_DIRECTIVES}
        proxy_pass ${LPFNO_BACKEND_UPSTREAM}/healthz;
    }

    location = /infer {
        proxy_http_version 1.1;
        proxy_set_header Host ${LPFNO_BACKEND_HOST_HEADER};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        ${LPFNO_BACKEND_TLS_DIRECTIVES}
        proxy_pass ${LPFNO_BACKEND_UPSTREAM}/infer;
    }

    location = /infer_path {
        client_max_body_size 256k;
        proxy_http_version 1.1;
        proxy_set_header Host ${LPFNO_BACKEND_HOST_HEADER};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        ${LPFNO_BACKEND_TLS_DIRECTIVES}
        proxy_pass ${LPFNO_BACKEND_UPSTREAM}/infer_path;
    }

    location = /infer_path/render3d {
        client_max_body_size 256k;
        proxy_http_version 1.1;
        proxy_set_header Host ${LPFNO_BACKEND_HOST_HEADER};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        ${LPFNO_BACKEND_TLS_DIRECTIVES}
        proxy_pass ${LPFNO_BACKEND_UPSTREAM}/infer_path/render3d;
    }

    location = /infer_path/presets {
        proxy_http_version 1.1;
        proxy_set_header Host ${LPFNO_BACKEND_HOST_HEADER};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        ${LPFNO_BACKEND_TLS_DIRECTIVES}
        proxy_pass ${LPFNO_BACKEND_UPSTREAM}/infer_path/presets;
    }

    # These back the model dropdowns, the straight-line page and the GT
    # comparison. Only the routes listed in this file are proxied: a new
    # backend route needs its own location block here, or it 404s.
    location = /models {
        proxy_http_version 1.1;
        proxy_set_header Host ${LPFNO_BACKEND_HOST_HEADER};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        ${LPFNO_BACKEND_TLS_DIRECTIVES}
        proxy_pass ${LPFNO_BACKEND_UPSTREAM}/models;
    }

    location = /gt_catalog {
        proxy_http_version 1.1;
        proxy_set_header Host ${LPFNO_BACKEND_HOST_HEADER};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        ${LPFNO_BACKEND_TLS_DIRECTIVES}
        proxy_pass ${LPFNO_BACKEND_UPSTREAM}/gt_catalog;
    }

    location = /infer/gt_compare {
        proxy_http_version 1.1;
        proxy_set_header Host ${LPFNO_BACKEND_HOST_HEADER};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        ${LPFNO_BACKEND_TLS_DIRECTIVES}
        proxy_pass ${LPFNO_BACKEND_UPSTREAM}/infer/gt_compare;
    }

    location = /infer_straight {
        proxy_http_version 1.1;
        proxy_set_header Host ${LPFNO_BACKEND_HOST_HEADER};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        ${LPFNO_BACKEND_TLS_DIRECTIVES}
        proxy_pass ${LPFNO_BACKEND_UPSTREAM}/infer_straight;
    }

    location = /infer_straight/render3d {
        proxy_http_version 1.1;
        proxy_set_header Host ${LPFNO_BACKEND_HOST_HEADER};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        ${LPFNO_BACKEND_TLS_DIRECTIVES}
        proxy_pass ${LPFNO_BACKEND_UPSTREAM}/infer_straight/render3d;
    }

    location = /config.json {
        add_header Cache-Control "no-store";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
