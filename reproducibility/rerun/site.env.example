# Site configuration for running training and evaluation on a Slurm GPU cluster.
#
# Copy to ~/.config/lpno/site.env (preferred: outside every repository) or to
# reproducibility/rerun/site.env (git-ignored) and fill in. Nothing in this file may ever be
# committed: tools/check_site_leaks.py refuses any of its values anywhere in the
# repository, and the file itself under any *site.env name.
#
# Every value below is a placeholder.

SITE_SSH=<ssh-alias>                 # Host entry in ~/.ssh/config (keys, user and proxy live there)
SITE_SSH_OPTS=-o BatchMode=yes       # extra ssh options, e.g. to drop port forwards for scripted commands
SITE_DENY=<cluster-name>,<user-name> # extra words the leak check must refuse, comma-separated

REMOTE_CODE=<path-on-cluster>/lpno/code         # where deploy.sh unpacks the committed code
REMOTE_MAMBA=<path-on-cluster>/micromamba       # micromamba executable on the cluster
REMOTE_ENV=<path-on-cluster>/envs/lpno          # the training environment (prefix)
REMOTE_DATA=<scratch-on-cluster>/lpno/data      # uploaded training/evaluation inputs
REMOTE_RUNS=<scratch-on-cluster>/lpno/runs      # run directories, checkpoints, metrics

SLURM_ACCOUNT=<account>
SLURM_PARTITION=<gpu-partition>
SLURM_QOS=<gpu-qos>
# SLURM_DEBUG_QOS=<debug-qos>        # only for DEBUG=1 jobs
SLURM_BUILD_QOS=<build-qos>          # environment builds (no GPU needed)
SLURM_GRES=gpu:1
